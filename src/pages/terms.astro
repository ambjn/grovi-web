---
import Layout from '@/layouts/Layout.astro';
import LegalPageLayout from '@/components/LegalPageLayout.astro';
import { renderContentToHtml } from '@/lib/markdown';
import { SITE_URL } from '@/lib/constants';
import content from '@/content/legal/terms.md?raw';

const contentHtml = renderContentToHtml(content);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${SITE_URL}/terms`,
      name: "Terms of Service – Grovi Studio",
      url: `${SITE_URL}/terms`,
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
        { "@type": "ListItem", position: 2, name: "Terms of Service", item: `${SITE_URL}/terms` },
      ],
    },
  ],
});
---

<Layout
  title="Terms of Service – Grovi Studio"
  description="Terms of service for Grovi Studio – describe an idea, get a playable mini app. Read about accounts, publishing, remixing, credits, and your rights."
  canonical={`${SITE_URL}/terms`}
  extraJsonLd={jsonLd}
>
  <LegalPageLayout title="Terms of Service" subtitle="Last updated: June 2026">
    <div set:html={contentHtml} />
  </LegalPageLayout>
</Layout>
