---
import Layout from '@/layouts/Layout.astro';
import { SITE_URL } from '@/lib/constants';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MobileApplication",
      "@id": `${SITE_URL}/#app`,
      name: "Grovi Studio",
      description: "Describe a game idea in chat, get a real playable mini-game in seconds. Publish, discover, and remix what others build.",
      applicationCategory: "GameApplication",
      operatingSystem: "iOS, Android",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${SITE_URL}/`,
      url: SITE_URL,
      name: "Grovi Studio – Turn Ideas Into Playable Mini-Games",
      description: "Describe a game idea in chat, get a real playable mini-game in seconds. Publish, discover, and remix what others build.",
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
  ],
});
---

<Layout
  title="Grovi Studio – Turn Ideas Into Playable Mini-Games"
  description="Describe a game idea in chat, get a real playable mini-game in seconds. Publish it, share it, remix it. No code required."
  canonical={SITE_URL}
  extraJsonLd={jsonLd}
>
  <main class="min-h-screen flex flex-col">
    <div class="flex-1 flex flex-col items-center justify-center pt-16 sm:pt-24">
    <section class="flex items-center justify-center px-4 sm:px-6 pb-6 sm:pb-8">
      <div class="flex flex-col sm:flex-row items-end gap-6 sm:gap-10">

        <div class="fade-up flex flex-col items-center">
          <img
            src="/icon-transparent.png"
            alt="Grovi Studio"
            width="240"
            height="240"
            class="w-40 h-40 sm:w-52 sm:h-52 drop-shadow-lg mb-4"
          />
          <span class="text-5xl sm:text-6xl font-semibold tracking-tight text-foreground">Grovi Studio</span>
        </div>

        <div class="hidden sm:block self-stretch w-px bg-foreground/20"></div>
        <hr class="sm:hidden w-64 border-foreground/20" />

        <div class="fade-up flex flex-col items-center text-center" style="--fu-delay: 80ms">
          <h1
            class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-foreground leading-[1.1] mb-6 max-w-md"
          >
            describe it.<br />
            <span class="text-primary">play it.</span>
          </h1>

          <p
            class="text-lg sm:text-xl text-muted-foreground max-w-sm leading-loose"
          >
            type a game idea in chat.<br />Grovi builds a real, playable mini-game<br />instantly, on your phone.
          </p>
        </div>
      </div>
    </section>

    <div class="flex justify-center py-10">
      <a
        href="https://testflight.apple.com/join/d7ZHMurt"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl bg-primary text-primary-foreground text-lg font-semibold hover:opacity-90 transition-opacity"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        Try on TestFlight
      </a>
    </div>
    </div>

    <footer class="border-t border-border px-5 py-10">
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
        <a href="/terms" class="hover:text-foreground transition-colors">Terms</a>
        <a href="/privacy" class="hover:text-foreground transition-colors">Privacy</a>
        <a href="/support" class="hover:text-foreground transition-colors">Support</a>
      </nav>
    </footer>
  </main>
</Layout>
