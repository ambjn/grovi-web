---
import Layout from '@/layouts/Layout.astro';
import { SITE_URL } from '@/lib/constants';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MobileApplication",
      "@id": `${SITE_URL}/#app`,
      name: "Grovi Studio",
      description: "Describe a game idea in chat, get a real playable mini-game in seconds. Publish, discover, and remix what others build.",
      applicationCategory: "GameApplication",
      operatingSystem: "iOS, Android",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${SITE_URL}/`,
      url: SITE_URL,
      name: "Grovi Studio – Turn Ideas Into Playable Mini-Games",
      description: "Describe a game idea in chat, get a real playable mini-game in seconds. Publish, discover, and remix what others build.",
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
  ],
});
---

<Layout
  title="Grovi Studio – Turn Ideas Into Playable Mini-Games"
  description="Describe a game idea in chat, get a real playable mini-game in seconds. Publish it, share it, remix it. No code required."
  canonical={SITE_URL}
  extraJsonLd={jsonLd}
>
  <main class="min-h-screen flex flex-col">
    <section class="flex-1 relative flex flex-col items-center justify-center text-center px-5 py-20 sm:py-28 overflow-hidden">
      <!-- Background blobs -->
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-[520px] h-[520px] bg-brand-400/10 blur-[120px] rounded-full"></div>
        <div class="absolute bottom-0 left-1/4 w-[320px] h-[320px] bg-blush-400/8 blur-[100px] rounded-full"></div>
      </div>

      <div class="relative z-10 flex flex-col items-center">
        <div class="fade-up flex flex-col items-center mb-8">
          <img src="/icon-transparent.png" alt="Grovi Studio" width="120" height="120" class="w-28 h-28 sm:w-32 sm:h-32 drop-shadow-lg mb-3" />
          <span class="text-xl font-semibold tracking-tight text-foreground">Grovi Studio</span>
        </div>

        <h1 class="fade-up text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tight text-foreground leading-[1.1] mb-5 max-w-2xl" style="--fu-delay: 80ms">
          describe it.<br />
          <span class="text-primary">play it.</span>
        </h1>

        <p class="fade-up text-lg sm:text-xl text-muted-foreground max-w-md leading-relaxed" style="--fu-delay: 160ms">
          Type a game idea in chat. Grovi Studio builds a real, playable mini-game from it — instantly, on your phone.
        </p>
      </div>
    </section>

    <footer class="border-t border-border px-5 py-10">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-2.5">
          <img src="/icon-transparent.png" alt="Grovi Studio" width="28" height="28" class="w-7 h-7" />
          <span class="font-semibold text-foreground">grovi studio</span>
        </div>
        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
          <a href="/terms" class="hover:text-foreground transition-colors">Terms</a>
          <a href="/privacy" class="hover:text-foreground transition-colors">Privacy</a>
          <a href="/support" class="hover:text-foreground transition-colors">Support</a>
          <a href="mailto:support@buildwithgrovi.xyz" class="hover:text-foreground transition-colors">support@buildwithgrovi.xyz</a>
        </nav>
        <p class="text-xs text-muted-foreground/60">© 2026 Grovi Studio</p>
      </div>
    </footer>
  </main>
</Layout>
