---
import Layout from '@/layouts/Layout.astro';
import LegalPageLayout from '@/components/LegalPageLayout.astro';
import { renderContentToHtml } from '@/lib/markdown';
import { SITE_URL } from '@/lib/constants';
import content from '@/content/legal/privacy.md?raw';

const contentHtml = renderContentToHtml(content);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${SITE_URL}/privacy`,
      name: "Privacy Policy – Grovi",
      url: `${SITE_URL}/privacy`,
      description: "How Grovi collects, uses, and protects your account and content data.",
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
        { "@type": "ListItem", position: 2, name: "Privacy Policy", item: `${SITE_URL}/privacy` },
      ],
    },
  ],
});
---

<Layout
  title="Privacy Policy – Grovi"
  description="How Grovi collects, uses, and protects your account and content data, including AI processing, publishing, and account deletion."
  canonical={`${SITE_URL}/privacy`}
  extraJsonLd={jsonLd}
>
  <LegalPageLayout title="Privacy Policy" subtitle="Last updated: June 2026">
    <div set:html={contentHtml} />
  </LegalPageLayout>
</Layout>
